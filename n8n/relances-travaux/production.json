{
  "name": "Relances travaux différés (socle) — INACTIF",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      },
      "name": "Toutes les 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://omphppsmhmyllapdqevn.supabase.co/rest/v1/rpc/preparer_relances_travaux",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"p_garages\": null}",
        "options": {}
      },
      "name": "Préparer les relances",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "fk85N6k6Aea2u0fb",
          "name": "RPC Supabase Production"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://omphppsmhmyllapdqevn.supabase.co/rest/v1/rpc/reserver_relances_travaux",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"p_limite\": 10, \"p_garages\": null}",
        "options": {}
      },
      "name": "Réserver les relances autorisées",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "fk85N6k6Aea2u0fb",
          "name": "RPC Supabase Production"
        }
      }
    },
    {
      "parameters": {
        "options": {}
      },
      "name": "Une relance à la fois",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $json.repondre_a }}",
        "toEmail": "={{ $json.destinataire }}",
        "subject": "={{ $json.sujet }}",
        "emailFormat": "text",
        "text": "={{ $json.texte }}",
        "options": {
          "appendAttribution": false,
          "replyTo": "={{ $json.repondre_a }}"
        }
      },
      "name": "Envoyer la relance (email)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        960,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "6opiCKNWBLDnvYKJ",
          "name": "SMTP Brevo — envois métier"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const r = $('Une relance à la fois').item.json;\nreturn [{ json: { id: r.id, resultat: 'envoye', motif: null } }];"
      },
      "name": "Accepté par le fournisseur",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $('Une relance à la fois').item.json;\nreturn [{ json: { id: r.id, resultat: 'a_reprendre', motif: 'refus du fournisseur d\\'envoi' } }];"
      },
      "name": "Refusé par le fournisseur",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://omphppsmhmyllapdqevn.supabase.co/rest/v1/rpc/terminer_relance_travail",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"p_id\": \"{{ $json.id }}\", \"p_resultat\": \"{{ $json.resultat }}\", \"p_motif\": {{ $json.motif === null || $json.motif === undefined ? 'null' : JSON.stringify($json.motif) }}}",
        "options": {}
      },
      "name": "Clore la relance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        300
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "fk85N6k6Aea2u0fb",
          "name": "RPC Supabase Production"
        }
      }
    }
  ],
