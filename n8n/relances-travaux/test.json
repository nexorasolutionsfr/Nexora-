    },
    {
      "parameters": {
        "jsCode": "// FAUX FOURNISSEUR — recette. N'envoie rien, ne contacte rien.\n// L'issue est pilotée par le destinataire, uniquement sur des boîtes .invalid :\n//   echec.transport@…     → échec CERTAIN avant envoi → à reprendre\n//   incertain.transport@… → issue INCERTAINE (accepté peut-être) → on ne clôt rien\n//   autre @….invalid      → accepté (simulé)\n// Tout destinataire hors .invalid est refusé : une erreur de jeu ne part jamais.\nconst r = $('Une relance à la fois').item.json;\nconst dest = String(r.destinataire || '').toLowerCase();\nif (!/@[a-z0-9.-]+\\.invalid$/.test(dest)) return [{ json: { id: r.id, resultat: 'bloque', motif: 'destinataire hors des boîtes de recette autorisées' } }];\nif (dest.startsWith('echec.transport@')) return [{ json: { id: r.id, resultat: 'a_reprendre', motif: 'échec certain avant envoi (simulé)' } }];\nif (dest.startsWith('incertain.transport@')) return [{ json: { id: r.id, resultat: 'incertain', motif: 'délai dépassé après acceptation possible (simulé)' } }];\nreturn [{ json: { id: r.id, resultat: 'envoye', motif: 'transport simulé (recette) : aucun message réel n\\'est parti' } }];"
      },
      "name": "Transport simulé (recette)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "issue-connue",
              "leftValue": "={{ $json.resultat }}",
              "rightValue": "incertain",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Issue connue ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
