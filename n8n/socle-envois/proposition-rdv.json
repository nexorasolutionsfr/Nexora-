    {
      "parameters": {
        "jsCode": "const notif = $('Une notification à la fois').item.json;\nconst prop = $('Récupérer la proposition').item.json;\nconst client = $('Récupérer le client').item.json;\nconst vehicule = $('Récupérer le véhicule').item.json;\nconst garage = $('Récupérer le garage').item.json;\nconst prestation = $('Récupérer la prestation').item.json;\nconst reserve = $('Une notification à la fois').item.json;\nconst nomAffiche = (garage && garage.nom_garage ? garage.nom_garage : 'Votre garage').replace(/[\"\\\\]/g, ' ').trim();\nconst nomVehicule = `${vehicule.marque || ''} ${vehicule.modele || ''}`.trim();\nconst immat = (vehicule && vehicule.immatriculation) ? ' (' + vehicule.immatriculation + ')' : '';\nconst dateTxt = new Date(prop.date_debut_proposee).toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });\nconst heureTxt = new Date(prop.date_debut_proposee).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });\nlet texte, sujet;\nif (notif.type === 'accepte') {\n  sujet = 'Votre rendez-vous est confirmé';\n  texte = `Bonjour ${client.nom || ''},\\n\\nVotre rendez-vous pour votre ${nomVehicule}${immat} — ${prestation.nom || 'intervention'} — est confirmé le ${dateTxt} à ${heureTxt} chez ${garage.nom_garage || 'notre garage'}.\\n\\nÀ bientôt,\\n${nomAffiche}`;\n} else if (notif.type === 'refuse') {\n  sujet = 'À propos de votre demande de rendez-vous';\n  texte = `Bonjour ${client.nom || ''},\\n\\nNous ne pouvons malheureusement pas donner suite à votre demande de rendez-vous pour le moment. N'hésitez pas à nous recontacter pour trouver un autre créneau.\\n\\n${nomAffiche}`;\n} else {\n  sujet = 'Votre rendez-vous a été modifié';\n  texte = `Bonjour ${client.nom || ''},\\n\\nVotre rendez-vous pour ${nomVehicule} a été déplacé au ${dateTxt} à ${heureTxt}.\\n\\n${nomAffiche}`;\n}\n\nconst expediteur = `\"${nomAffiche}\" <nexorasolutions.france@gmail.com>`;\nconst repondreA = (garage && garage.email) ? garage.email : '';\n\nreturn [{ json: { expediteur, repondreA, notif_id: reserve.id, id: notif.id, client_email: client.email || '', texte, sujet } }];"
      },
      "id": "d8bae886-8626-40ea-960f-088ed255ddc6",
      "name": "Construire le message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2800,
