    {
      "parameters": {
        "jsCode": "const notif = $('Une notification à la fois').item.json;\nconst devis = $('Récupérer le devis').item.json;\nconst client = $('Récupérer le client').item.json;\nconst vehicule = $('Récupérer le véhicule').item.json;\nconst garage = $('Récupérer le garage').item.json;\nconst reserve = $('Une notification à la fois').item.json;\nconst nomAffiche = (garage && garage.nom_garage ? garage.nom_garage : 'Votre garage').replace(/[\"\\\\]/g, ' ').trim();\nconst nomVehicule = `${vehicule.marque || ''} ${vehicule.modele || ''}`.trim();\nconst immat = (vehicule && vehicule.immatriculation) ? ' (' + vehicule.immatriculation + ')' : '';\nconst lien = `${reserve.url_publique}/devis/${reserve.jeton}`;\nlet texte, sujet;\nif (notif.type === 'accepte') {\n  sujet = 'Votre devis a été confirmé';\n  texte = `Bonjour ${client.nom || ''},\\n\\nVotre devis pour ${nomVehicule}${immat} (${devis.montant_ttc} € TTC) a bien été confirmé. Nous vous contacterons pour planifier l'intervention.\\n\\nÀ bientôt,\\n${nomAffiche}`;\n} else if (notif.type === 'refuse') {\n  sujet = 'À propos de votre devis';\n  texte = `Bonjour ${client.nom || ''},\\n\\nVotre devis pour ${nomVehicule}${immat} n'a pas été confirmé. N'hésitez pas à nous recontacter si vous souhaitez en discuter.\\n\\n${nomAffiche}`;\n} else {\n  sujet = 'Un devis vous attend';\n  texte = `Bonjour ${client.nom || ''},\\n\\n${garage.nom_garage || 'Votre garage'} vous propose un devis pour votre ${nomVehicule}${immat} : ${devis.montant_ttc} €.\\n\\nPour accepter ou refuser ce devis, cliquez ici : ${lien}\\n\\nÀ bientôt,\\n${nomAffiche}`;\n}\n\nconst expediteur = `\"${nomAffiche}\" <nexorasolutions.france@gmail.com>`;\nconst repondreA = (garage && garage.email) ? garage.email : '';\n\nreturn [{ json: { expediteur, repondreA, notif_id: reserve.id, id: notif.id, client_email: client.email || '', texte, sujet } }];"
      },
      "id": "9c523dac-371e-42dd-b4b3-4ec9d2177ee5",
      "name": "Construire le message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
