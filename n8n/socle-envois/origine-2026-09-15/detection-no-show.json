      "parameters": {
        "jsCode": "const ARRIVE_STAGES = ['depose', 'diagnostic', 'attente_client', 'intervention', 'pret'];\nconst now = new Date();\nconst cutoff = new Date(now.getTime() - 2 * 24 * 60 * 60 * 1000);\n\nconst result = [];\nfor (const item of $input.all()) {\n  const rdv = item.json;\n  const fin = new Date(rdv.date_fin);\n  if (!(fin < now && fin > cutoff)) continue;\n  if (ARRIVE_STAGES.includes(rdv.statut_atelier)) continue;\n  result.push({ json: rdv });\n}\nreturn result;"
      },
