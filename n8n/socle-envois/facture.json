    {
      "parameters": {
        "jsCode": "const notif = $('Une notification à la fois').item.json;\nconst facture = $('Récupérer la facture').item.json;\nconst client = $('Récupérer le client').item.json;\nconst vehicule = $('Récupérer le véhicule').item.json;\nconst garage = $('Récupérer le garage').item.json;\nconst reserve = $('Une notification à la fois').item.json;\nconst nomAffiche = (garage && garage.nom_garage ? garage.nom_garage : 'Votre garage').replace(/[\"\\\\]/g, ' ').trim();\nconst nomVehicule = `${vehicule.marque || ''} ${vehicule.modele || ''}`.trim();\nconst immat = (vehicule && vehicule.immatriculation) ? ' (' + vehicule.immatriculation + ')' : '';\nconst lien = `${reserve.url_publique}/facture/${reserve.jeton}`;\nlet texte, sujet;\nif (notif.type === 'payee') {\n  sujet = 'Confirmation de paiement';\n  texte = `Bonjour ${client.nom || ''},\\n\\nNous confirmons la bonne réception de votre paiement pour la facture ${facture.numero} — votre ${nomVehicule}${immat} — d'un montant de ${facture.montant_ttc} € TTC.\\n\\nMerci de votre confiance,\\nL'équipe ${garage.nom_garage || 'du garage'}`;\n} else {\n  sujet = `Votre facture ${facture.numero}`;\n  texte = `Bonjour ${client.nom || ''},\\n\\n${garage.nom_garage || 'Votre garage'} vous transmet la facture ${facture.numero} pour votre ${nomVehicule}${immat} : ${facture.montant_ttc} € TTC.\\n\\nConsultez le détail ici : ${lien}\\n\\nÀ bientôt,\\n${nomAffiche}`;\n}\n\nconst expediteur = `\"${nomAffiche}\" <nexorasolutions.france@gmail.com>`;\nconst repondreA = (garage && garage.email) ? garage.email : '';\n\nreturn [{ json: { expediteur, repondreA, notif_id: reserve.id, id: notif.id, client_email: client.email || '', texte, sujet } }];"
      },
      "id": "a6683c75-5494-41ab-9238-b481d44664d0",
      "name": "Construire le message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2800,
        -288
      ]
    },
