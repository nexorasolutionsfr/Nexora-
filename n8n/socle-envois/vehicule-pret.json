    {
      "parameters": {
        "jsCode": "const notif = $('Une notification à la fois').item.json;\nconst rdv = $('Récupérer le rdv').item.json;\nconst client = $('Récupérer le client').item.json;\nconst vehicule = $('Récupérer le véhicule').item.json;\nconst garage = $('Récupérer le garage').item.json;\nconst reserve = $('Une notification à la fois').item.json;\nconst nomAffiche = (garage && garage.nom_garage ? garage.nom_garage : 'Votre garage').replace(/[\"\\\\]/g, ' ').trim();\nconst nomVehicule = `${vehicule.marque || ''} ${vehicule.modele || ''}`.trim();\nconst immat = (vehicule && vehicule.immatriculation) ? ' (' + vehicule.immatriculation + ')' : '';\nlet texte = `Bonjour ${client.nom || ''},\\n\\nVotre véhicule ${nomVehicule}${immat} est prêt, vous pouvez venir le récupérer chez ${garage.nom_garage || 'notre garage'}.`;\nif ($json.lien_paiement_final) {\n  texte += `\\n\\nVous pouvez régler en ligne dès maintenant : ${$json.lien_paiement_final}`;\n}\ntexte += `\\n\\nÀ bientôt,\\n${nomAffiche}`;\n\nconst expediteur = `\"${nomAffiche}\" <nexorasolutions.france@gmail.com>`;\nconst repondreA = (garage && garage.email) ? garage.email : '';\n\nreturn [{ json: { expediteur, repondreA, notif_id: reserve.id, id: notif.id, client_email: client.email || '', texte } }];"
      },
      "id": "49b0366a-0aa9-4668-be8c-273ce05fb3d3",
      "name": "Construire le message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2800,
        -288
      ]
    },
    {
